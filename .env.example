# Copie para server/.env
DATABASE_URL=postgres://painel:painel@localhost:5432/painel_gestor
JWT_SECRET=troque-este-segredo
PORT=3000
# Endereço público do sistema (links de e-mail, portal, cobrança e webhook da nota fiscal)
APP_URL=http://localhost:5173

# --- E-mail (recuperação de senha e convites) ---
# Sem chave, os e-mails ficam só registrados (histórico e log do servidor).
RESEND_API_KEY=
EMAIL_FROM=Painel Gestor <nao-responda@seudominio.com.br>

# --- Fotos e artes ---
# "disco" grava em UPLOAD_DIR; "s3" usa Amazon S3, Cloudflare R2 ou MinIO.
STORAGE=disco
UPLOAD_DIR=./uploads
S3_BUCKET=
# Para Cloudflare R2: https://<id-da-conta>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Monitoramento de erros (opcional) ---
SENTRY_DSN=

# WhatsApp (Z-API) e nota fiscal (Focus NFe) são configurados por empresa,
# dentro do sistema: Configurações → Integrações.
